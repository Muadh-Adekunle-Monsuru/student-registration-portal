// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Student {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  firstName   String?
  lastName    String?
  email       String?
  CGPA        String?
  supervisor  String?
  supervisees String[]
  createdAt   DateTime @default(now())
  Courses     Courses? @relation(fields: [coursesId], references: [id])
  coursesId   String?  @db.ObjectId
}

model Courses {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String    @unique
  code        String?
  description String?
  credits     Int?
  semester    String?
  students    Student[]
  createdAt   DateTime  @default(now())
}
